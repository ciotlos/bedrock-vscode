{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": ["**/*.ts", "**/*.js", "!out", "!.vscode-test", "!**/*.d.ts", "!scripts", "!**/*vscode.d.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"semicolons": "always",
			"trailingCommas": "es5",
			"quoteStyle": "double",
			"arrowParentheses": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"style": {
				"useBlockStatements": "warn",
				"useConst": "error"
			},
			"suspicious": {
				"noEmptyBlockStatements": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/test/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	]
}
